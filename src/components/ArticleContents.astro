---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
---
<aside class="contents rail" id="article-contents" data-pagefind-ignore aria-label="章节导航">
  <h2>本文目录</h2>
  <nav aria-label="本文目录">
    {headings.map(({ depth, slug, text }) => <a data-heading={slug} style={`--level: ${depth - 2}`} href={`#${slug}`}><span title={text}>{text}</span></a>)}
  </nav>
  <span class="chapter-hint" aria-hidden="true" hidden></span>
</aside>
<style>
  .contents nav a { padding-inline-start: calc(.65em + var(--level) * .72em); }
  @media (any-pointer: coarse) {
    .contents nav a { min-width: 44px; min-height: 44px; align-content: center; }
  }
  .chapter-hint {
    position: fixed;
    z-index: 2;
    inline-size: max-content;
    max-inline-size: min(22em, calc(100vw - 3.5rem));
    padding: .3em .75em;
    color: var(--ink);
    background: var(--paper);
    border: var(--rule);
    border-radius: var(--radius);
    line-height: 1.55;
  }
  @media (min-width: 960px) {
    :global(html:not([data-mini-toc])) .contents {
      display: flex;
      flex-direction: column;
      max-height: calc(100dvh - max(var(--article-top, 50dvh), var(--s4)));
    }
    :global(html:not([data-mini-toc])) .contents h2 { flex: none; }
    :global(html:not([data-mini-toc])) .contents nav { max-height: none; }
  }
  @media (width < 960px) {
    .contents:not(:popover-open) { display: none; }
    .contents:popover-open {
      position: fixed;
      inset: var(--contents-top) var(--contents-right) var(--contents-bottom) auto;
      display: flex;
      flex-direction: column;
      inline-size: min(19rem, calc(100vw - var(--gutter) * 2));
      block-size: min(18rem, var(--contents-space));
      margin: 0;
      padding: var(--s1) var(--s2);
      border: var(--rule);
      border-radius: var(--radius);
      background: var(--paper);
      color: var(--ink);
    }
    .contents h2 { flex: none; }
    .contents nav { flex: 1; min-height: 0; max-height: none; align-content: start; margin: var(--s1) 0 0; }
    .contents nav a { min-height: 44px; align-content: center; }
  }
  :global(html[data-mini-toc]) .contents {
    --node-width: 40px;
    --rest-mark: 12px;
    --chapter-mark: 32px;
    --level-step: 5px;
    --step: 10px;
    width: var(--node-width);
    margin-inline-start: auto;
    z-index: 1;
    padding: 0;
    background: transparent;
  }
  :global(html[data-mini-toc]) .contents h2 { display: none; }
  :global(html[data-mini-toc]) .contents nav {
    display: grid;
    grid-template-columns: 1fr;
    max-height: calc(100dvh - var(--s4) * 2);
    overflow: hidden auto;
    scrollbar-width: none;
    margin: 0;
    padding: 0;
  }
  :global(html[data-mini-toc]) .contents nav a {
    --level-mark: calc(var(--chapter-mark) - var(--level) * var(--level-step));
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: var(--step);
    padding: 0;
    padding-inline-end: 3px;
    outline-offset: -2px;
    -webkit-tap-highlight-color: transparent;
    color: var(--outline-idle);
  }
  :global(html[data-mini-toc]) .contents a span {
    position: absolute;
    width: 1px;
    block-size: 1px;
    clip-path: inset(50%);
    overflow: hidden;
  }
  :global(html[data-mini-toc]) .contents a::before {
    content: '';
    width: var(--rest-mark);
    height: 2px;
    border-radius: var(--radius);
    background: currentColor;
  }
  :global(html[data-mini-toc]) .contents:has(a:focus-visible, .chapter-hint:not([hidden])) a::before { width: var(--level-mark); }
  @media (hover: hover) {
    :global(html[data-mini-toc]) .contents:hover a::before { width: var(--level-mark); }
  }
  :global(html[data-mini-toc]) .contents nav a:is(:hover, :focus-visible) { color: var(--outline-hover); }
  :global(html[data-mini-toc]) .contents nav a[aria-current] { color: var(--outline-current); }
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-mini-toc]) .contents nav a { transition: color var(--motion-ink) ease-out; }
    :global(html[data-mini-toc]) .contents a::before { transition: width var(--motion-settle) var(--ease-settle); }
    .chapter-hint:not([hidden]) { animation: hint-in var(--motion-ink) ease-out; }
    @keyframes hint-in { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
<script>
  const toc = document.querySelector<HTMLElement>('.contents');
  if (toc) setup(toc);

  function setup(toc: HTMLElement) {
    const root = document.documentElement;
    const prose = document.querySelector<HTMLElement>('.prose')!;
    const trigger = document.querySelector<HTMLButtonElement>('#contents-trigger')!;
    const narrow = matchMedia('(width < 960px)');
    const nav = toc.querySelector('nav')!;
    const links = Array.from(nav.querySelectorAll('a'));
    const headings = links.map(a => document.getElementById(a.dataset.heading!)!);
    const hint = toc.querySelector<HTMLElement>('.chapter-hint')!;
    let active = -1;
    let frame = 0;
    let preview: HTMLAnchorElement | null = null;
    let fragmentIndex = -1;

    function showHint(link: HTMLAnchorElement | null) {
      preview = root.hasAttribute('data-mini-toc') ? link : null;
      hint.hidden = !preview;
      if (!preview) return;
      if (hint.textContent !== preview.textContent) hint.textContent = preview.textContent;
      const box = preview.getBoundingClientRect();
      const area = nav.getBoundingClientRect();
      if (box.bottom <= area.top || box.top >= area.bottom || box.bottom <= 0 || box.top >= innerHeight) {
        showHint(null);
        return;
      }
      hint.style.right = `${root.clientWidth - box.left}px`;
      const top = box.top + (box.height - hint.offsetHeight) / 2;
      hint.style.top = `${Math.max(4, Math.min(innerHeight - hint.offsetHeight - 4, top))}px`;
    }

    function reveal(link: HTMLAnchorElement) {
      const box = link.getBoundingClientRect();
      const area = nav.getBoundingClientRect();
      if (box.top < area.top) nav.scrollTop += box.top - area.top;
      if (box.bottom > area.bottom) nav.scrollTop += box.bottom - area.bottom;
    }

    function positionPanel() {
      const anchor = trigger.getBoundingClientRect();
      const gap = 6;
      const edge = 8;
      const above = anchor.top - gap - edge;
      const below = root.clientHeight - anchor.bottom - gap - edge;
      const openAbove = above > below;
      toc.style.setProperty('--contents-top', openAbove ? 'auto' : `${anchor.bottom + gap}px`);
      toc.style.setProperty('--contents-bottom', openAbove ? `${root.clientHeight - anchor.top + gap}px` : 'auto');
      toc.style.setProperty('--contents-right', `${Math.max(edge, root.clientWidth - anchor.right)}px`);
      toc.style.setProperty('--contents-space', `${Math.max(0, openAbove ? above : below)}px`);
    }

    function syncPopover() {
      if ((!narrow.matches || root.hasAttribute('data-reading')) && toc.matches(':popover-open')) toc.hidePopover();
      toc.toggleAttribute('popover', narrow.matches);
      trigger.hidden = !narrow.matches;
      if (active >= 0) reveal(links[active]);
      schedule();
    }

    function update() {
      frame = 0;
      if (root.hasAttribute('data-reading')) return;
      const guide = parseFloat(getComputedStyle(headings[0]).scrollMarginTop) + 1;
      let current = 0;
      for (let i = 1; i < headings.length; i++) {
        if (headings[i].getBoundingClientRect().top > guide) break;
        current = i;
      }
      const atBottom = scrollY > 0 && Math.ceil(scrollY + root.clientHeight) >= root.scrollHeight;
      if (atBottom) current = links.length - 1;
      const top = headings[fragmentIndex]?.getBoundingClientRect().top;
      if (top !== undefined && top >= guide - 3 && top < root.clientHeight && (atBottom || top <= guide + 3)) {
        current = fragmentIndex;
      } else {
        fragmentIndex = -1;
      }
      if (current !== active) {
        links[active]?.removeAttribute('aria-current');
        active = current;
        links[active].setAttribute('aria-current', 'location');
        reveal(links[active]);
      }
      if (toc.matches(':popover-open')) {
        const anchor = trigger.getBoundingClientRect();
        if (anchor.bottom <= 0 || anchor.top >= root.clientHeight) toc.hidePopover();
        else positionPanel();
      }
      if (preview) showHint(preview);
    }
    function schedule() { if (!frame) frame = requestAnimationFrame(update); }
    function followFragment() {
      fragmentIndex = -1;
      try {
        const id = decodeURIComponent(location.hash.slice(1));
        fragmentIndex = headings.findIndex(heading => heading.id === id);
      } catch {}
      schedule();
    }
    function linkAt(target: EventTarget | null) {
      return target instanceof Element ? target.closest<HTMLAnchorElement>('a[data-heading]') : null;
    }
    nav.addEventListener('pointerover', event => {
      if (event.pointerType === 'mouse') showHint(linkAt(event.target));
    });
    toc.addEventListener('pointerleave', event => {
      if (event.pointerType === 'mouse' && !preview?.matches(':focus-visible')) showHint(null);
    });
    nav.addEventListener('focusin', event => {
      const link = linkAt(event.target);
      if (link?.matches(':focus-visible')) showHint(link);
    });
    nav.addEventListener('focusout', () => showHint(null));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') showHint(null);
    });
    document.addEventListener('pointerdown', event => {
      if (!(event.target instanceof Node && toc.contains(event.target))) showHint(null);
    });
    nav.addEventListener('click', event => {
      if (!linkAt(event.target)) return;
      if (!event.defaultPrevented && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey &&
          toc.matches(':popover-open')) toc.hidePopover();
      showHint(null);
      requestAnimationFrame(followFragment);
    });
    nav.addEventListener('scroll', () => { if (preview) showHint(preview); }, { passive: true });
    toc.addEventListener('beforetoggle', event => {
      if (event.newState === 'open') positionPanel();
    });
    toc.addEventListener('toggle', () => {
      if (!toc.matches(':popover-open')) return;
      if (active >= 0) reveal(links[active]);
    });
    narrow.addEventListener('change', syncPopover);
    new MutationObserver(() => {
      showHint(null);
      syncPopover();
    }).observe(root, { attributes: true, attributeFilter: ['data-mini-toc', 'data-reading'] });
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('pageshow', followFragment);
    window.addEventListener('hashchange', followFragment);
    new ResizeObserver(schedule).observe(prose);
    document.fonts.ready.then(schedule);
    syncPopover();
    followFragment();
  }
</script>
