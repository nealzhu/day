---
import { commentTerm } from '../lib/comments';

interface Props { articleId: string }
const { articleId } = Astro.props;
const production = import.meta.env.MODE === 'production';
---

<section class="comments" aria-labelledby="comments-heading" data-pagefind-ignore
  data-comment-term={production ? commentTerm(articleId) : undefined}>
  <div class="comments-header">
    <h2 id="comments-heading">评论</h2>
    <a class="discussion-link" target="_blank" rel="noopener noreferrer" hidden>在 GitHub 查看讨论</a>
  </div>
  <div class="comments-controls">
    <p role="status" class="comments-status">此环境未启用评论。</p>
    <button class="comments-load" type="button" hidden>加载评论</button>
  </div>
  {production && <div class="giscus" id="comments"></div>}
</section>

<script>
  import { comments } from '../lib/comments';

  const section = document.querySelector<HTMLElement>('[data-comment-term]');
  if (section && location.origin === comments.siteOrigin) {
    const root = document.documentElement;
    const host = section.querySelector<HTMLElement>('.giscus')!;
    const status = section.querySelector<HTMLElement>('.comments-status')!;
    const button = section.querySelector<HTMLButtonElement>('.comments-load')!;
    const discussion = section.querySelector<HTMLAnchorElement>('.discussion-link')!;
    const systemTheme = matchMedia('(prefers-color-scheme: dark)');
    const lifetime = new AbortController();
    const { signal } = lifetime;
    const { siteOrigin: _site, providerOrigin, ...config } = comments;
    const frame = () => host.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    let script: HTMLScriptElement | undefined;
    let timeout = 0;
    let near = false;
    let started = false;
    let connected = false;
    let frameTheme: string | undefined;

    function theme() {
      const preference = root.dataset.theme;
      return preference === 'dark' || (preference !== 'light' && systemTheme.matches) ? 'transparent_dark' : 'light';
    }

    function syncTheme() {
      const current = theme();
      const target = frame()?.contentWindow;
      if (!connected || current === frameTheme || !target) return;
      target.postMessage({ giscus: { setConfig: { theme: current } } }, providerOrigin);
      frameTheme = current;
    }

    function ready() {
      clearTimeout(timeout);
      section!.dataset.state = 'ready';
      status.textContent = '';
      button.hidden = true;
    }

    function failed() {
      clearTimeout(timeout);
      section!.dataset.state = 'failed';
      status.textContent = '暂时无法加载评论，请稍后重试。';
      button.textContent = '重试';
      button.hidden = false;
    }

    const startOnScroll = new AbortController();
    const observer = 'IntersectionObserver' in window ? new IntersectionObserver(([entry]) => {
      near = entry.isIntersecting;
      loadWhenNear();
    }, { rootMargin: '0px 0px 240px' }) : undefined;

    function loadWhenNear() {
      // A short article can put comments in view on the initial paint.
      if (near && scrollY > 0 && !root.hasAttribute('data-reading')) load();
    }

    function load() {
      if (section!.dataset.state === 'loading') return;
      if (!started) {
        started = true;
        observer?.disconnect();
        startOnScroll.abort();
      }
      section!.dataset.state = 'loading';
      status.textContent = '正在加载评论…';
      button.hidden = true;
      clearTimeout(timeout);
      timeout = window.setTimeout(failed, 15_000);

      const iframe = frame();
      if (iframe) {
        // Keep the iframe and the native client's single message listener on retries.
        connected = false;
        const url = new URL(iframe.src);
        frameTheme = theme();
        url.searchParams.set('theme', frameTheme);
        iframe.src = url.href;
      } else if (!script) {
        frameTheme = theme();
        script = document.createElement('script');
        script.src = `${providerOrigin}/client.js`;
        script.async = true;
        script.crossOrigin = 'anonymous';
        Object.assign(script.dataset, config, { term: section!.dataset.commentTerm, theme: frameTheme });
        script.addEventListener('load', () => {
          script?.remove();
          script = undefined;
          const iframe = frame();
          if (iframe) iframe.title = '文章评论';
          else failed();
        }, { once: true, signal });
        script.addEventListener('error', () => {
          script?.remove();
          script = undefined;
          failed();
        }, { once: true, signal });
        host.after(script);
      }
    }

    window.addEventListener('message', event => {
      if (event.origin !== providerOrigin) return;
      // The native client checks the origin. Guard its listener against other frames at that origin.
      const source = frame()?.contentWindow;
      if (!source || event.source !== source) {
        event.stopImmediatePropagation();
        return;
      }
      const message = event.data?.giscus;
      if (!message || typeof message !== 'object') return;
      if (message.signOut === true || (typeof message.error === 'string' &&
          /Bad credentials|Invalid state value|State has expired/.test(message.error))) {
        // The native client clears the expired session and reloads this same iframe.
        connected = false;
        frameTheme = undefined;
        return;
      }
      connected = true;
      syncTheme();
      if (typeof message.error === 'string') {
        if (message.error.startsWith('Discussion not found')) {
          discussion.hidden = true;
          discussion.removeAttribute('href');
          ready();
        } else failed();
      }
      if (typeof message.discussion?.url === 'string') {
        const path = `https://github.com/${config.repo}/discussions/`;
        const url = message.discussion.url;
        if (url.startsWith(path) && /^[1-9]\d*$/.test(url.slice(path.length))) {
          discussion.href = url;
          discussion.hidden = false;
          ready();
        }
      }
    }, { capture: true, signal });

    const themeObserver = new MutationObserver(syncTheme);
    themeObserver.observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    systemTheme.addEventListener('change', syncTheme, { signal });
    window.addEventListener('pagehide', event => {
      if (event.persisted) return;
      lifetime.abort();
      startOnScroll.abort();
      observer?.disconnect();
      themeObserver.disconnect();
      clearTimeout(timeout);
    }, { signal });

    status.textContent = '';
    button.hidden = false;
    button.addEventListener('click', load, { signal });
    observer?.observe(section);
    if (observer) window.addEventListener('scroll', loadWhenNear, { passive: true, signal: startOnScroll.signal });
  }
</script>

<style>
  .comments {
    grid-column: 1;
    min-width: 0;
    margin-block-start: var(--s4);
    padding-block-start: var(--s3);
    border-top: var(--group-rule);
  }
  :global(html[data-reading]) .comments { display: none; }
  .comments-header, .comments-controls { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s2); }
  .comments-header { justify-content: space-between; margin-block-end: var(--s1); }
  .comments-header h2 { font-size: var(--h3); }
  .discussion-link, .comments-status, .comments-load { font-size: var(--small); }
  .comments-status { margin: 0; color: var(--muted); }
  .comments-load {
    min-height: 44px;
    padding: 0 var(--s2);
    border: var(--rule);
    border-radius: var(--radius);
    background: var(--inset);
  }
  .comments[data-state='ready'] .comments-controls { display: none; }
  .comments:not([data-state='ready']) .giscus { height: 0; min-height: 0; overflow: hidden; visibility: hidden; }
  .giscus :global(.giscus-frame) { display: block; }
</style>
