---
import { categories } from '../lib/content-model';
import { firstImage, postPath, type Post } from '../lib/posts';

interface Props { posts: Post[]; switchable?: boolean }
const { posts, switchable } = Astro.props;
// Preserve the order supplied by publishedPosts, including its same-day tie break.
const years = new Map<string, Post[]>();
for (const post of posts) {
  const year = post.data.publishedAt.slice(0, 4);
  if (!years.has(year)) years.set(year, []);
  years.get(year)!.push(post);
}
---
<div class="posts" data-view="list">
  {posts.length === 0 && <p>暂无已发布文章。</p>}
  {Array.from(years, ([year, entries]) => <section class="year">
    <header><h2>{year}</h2><span>{entries.length} 篇</span></header>
    <ul>
      {entries.map(post => {
        const { title, publishedAt, description, slug, category } = post.data;
        const cover = switchable && firstImage(post);
        return <li class:list={[{ 'text-only': !cover }]}>
          {cover && <template><img src={cover.src} alt={cover.alt} loading="lazy" /></template>}
          <div class="meta"><time datetime={publishedAt}>{publishedAt.slice(5).replace('-', ' 月 ')} 日</time>{category && <span>{categories[category]}</span>}</div>
          <h3><a href={postPath(slug)}>{title}</a></h3>
          <p>{description}</p>
        </li>;
      })}
    </ul>
  </section>)}
</div>
<style>
  .year { border-top: var(--rule); display: grid; grid-template-columns: minmax(7rem, 1fr) minmax(0, 4fr); gap: var(--s3); }
  .year > header { padding-block: var(--s3); color: var(--muted); }
  .year h2 { font-size: var(--h1); color: var(--accent); font-variant-numeric: lining-nums; }
  .year header span, .meta { font-size: var(--small); color: var(--muted); }
  ul { padding: 0; margin: 0; list-style: none; }
  li { position: relative; padding-block: var(--s3) var(--s4); }
  li + li { border-top: var(--rule); }
  h3 { font-size: var(--h2); margin-block: .18em; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  li:hover a, h3 a:focus-visible { color: var(--accent); text-decoration: underline; }
  .meta { display: flex; align-items: center; gap: .7em; }
  .meta span { border-inline-start: var(--rule); padding-inline-start: .7em; }
  p { margin: 0; color: var(--muted); }
  [data-view="list"] img { display: none; }
  [data-view="cards"] ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--s3); padding-block: var(--s3); }
  [data-view="cards"] li { border: 0; padding: 0; display: flex; flex-direction: column; align-items: start; }
  [data-view="cards"] img, [data-view="cards"] .text-only h3 {
    width: 100%; aspect-ratio: 5 / 3; background: var(--inset); border-radius: var(--radius);
  }
  [data-view="cards"] img { display: block; object-fit: cover; }
  [data-view="cards"] .text-only h3 {
    order: -1; margin: 0; display: grid; place-items: center; text-align: center; padding: var(--s2);
  }
  [data-view="cards"] .meta { margin-top: var(--s2); }
  [data-view="cards"] h3 { font-size: var(--h3); }
  [data-view="cards"] p { font-size: 1rem; }
  [data-view="cards"] .text-only p { margin-top: .3em; }
  @media (max-width: 600px) {
    .year { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .year > header { display: flex; align-items: baseline; gap: var(--s1); padding-block: var(--s2) 0; }
    .year h2 { font-size: var(--h3); }
    li { padding-block: var(--s2) var(--s3); }
  }
</style>
