---
interface Props {
  name: 'book' | 'cards' | 'list' | 'tag';
  size?: number;
}
const { name, size = 18 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'book' && <>
    <path d="M12 6.5C9.5 4.7 6.3 4.1 2.8 4.6v13c3.5-.5 6.7.2 9.2 2 2.5-1.8 5.7-2.5 9.2-2v-13c-3.5-.5-6.7.1-9.2 1.9Zm0 0v13" />
    <path d="M15.8 4.9v5.1l1.7-1.3 1.5.7v-5" />
  </>}
  {name === 'cards' && <>
    <rect x="3" y="3.5" width="18" height="13" rx="1.7" />
    <path d="m3.5 13.8 4.8-4.2 3.5 2.8 3.7-4 5 4.5M3.8 20.4H15" />
  </>}
  {name === 'list' && (
    <path d="M3.5 5.5h1.8m4 0h11.2M3.5 12h1.8m4 0H17M3.5 18.5h1.8m4 0h10" />
  )}
  {name === 'tag' && <>
    <path d="M5.5 3.8h5.3c.6 0 1.2.2 1.6.7l7.8 7.8a1.7 1.7 0 0 1 0 2.4l-5.5 5.5a1.7 1.7 0 0 1-2.4 0l-7.8-7.8a2.3 2.3 0 0 1-.7-1.6V5.5c0-.9.8-1.7 1.7-1.7Z" />
    <circle cx="8.2" cy="8.2" r="1.1" fill="currentColor" stroke="none" />
  </>}
</svg>
