---
import { categories, categoryKeys } from '../lib/content-model';
import { categoryPath } from '../lib/posts';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · qians.day</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(pathname, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title="qians.day" href="/rss.xml" />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="mast">
      <a class="brand" href="/">qians.day</a>
      <nav aria-label="网站导航">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>首页</a>
        <a href="/categories/" aria-current={pathname === '/categories/' ? 'page' : undefined}>分类</a>
        {categoryKeys.map(key => {
          const path = categoryPath(key);
          return <a href={path} aria-current={pathname === path ? 'page' : undefined}>{categories[key]}</a>;
        })}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer><a href="/rss.xml">RSS 订阅</a></footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { max-width: 66rem; margin: auto; padding: 0 clamp(1rem, 5vw, 3rem); color: #242a27; background: #fafaf8; font: 1rem/1.65 system-ui, sans-serif; overflow-wrap: anywhere; }
  a { color: #245944; text-underline-offset: .2em; }
  :focus-visible { outline: 2px solid #246d50; outline-offset: 3px; }
  .skip { position: absolute; top: -4em; background: white; }
  .skip:focus { top: .5em; }
  .mast, .mast nav, .section-head { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.2rem; }
  .mast, .section-head { justify-content: space-between; }
  .mast { min-height: 4.5rem; padding: 1rem 0; border-bottom: 1px solid #cdd4cd; }
  .brand { font-size: 1.4rem; font-weight: 700; color: inherit; text-decoration: none; }
  [aria-current="page"] { font-weight: 700; }
  main { padding: clamp(2rem, 6vw, 4rem) 0; min-height: 55vh; }
  h1, h2, h3 { line-height: 1.35; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 0 0 1.1rem; }
  .section-head h1 { margin: 0; }
  .quiet, time { color: #545e57; }
  footer { border-top: 1px solid #cdd4cd; padding: 1rem 0 2rem; }
  img { max-width: 100%; height: auto; }
  pre { overflow-x: auto; padding: 1rem; }
  [hidden] { display: none !important; }
</style>
