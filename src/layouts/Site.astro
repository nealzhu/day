---
import '../styles/site.css';
import ReadingSettings from '../components/ReadingSettings.astro';
import SiteIcon from '../components/SiteIcon.astro';
import { categories, categoryKeys } from '../lib/content-model';
import { categoryPath } from '../lib/posts';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex } = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN" data-view="cards">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        if (localStorage.getItem('qians.day:post-view') === 'list') document.documentElement.dataset.view = 'list';
        const theme = localStorage.getItem('qians.day:theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        if (localStorage.getItem('qians.day:mini-toc') === 'true') document.documentElement.setAttribute('data-mini-toc', '');
      } catch {}
    </script>
    <title>{title} · 骞言碎语</title>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(pathname, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title="骞言碎语" href="/rss.xml" />
    <link rel="stylesheet" href="/fonts/v1.530/faces.css" />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="mast shell">
      <a class="brand" href="/">骞言碎语</a>
      <nav aria-label="文章分类">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>全部</a>
        {categoryKeys.map(key => <a href={categoryPath(key)} aria-current={pathname === categoryPath(key) ? 'page' : undefined}>{categories[key]}</a>)}
      </nav>
      <ReadingSettings />
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="shell colophon">
      <span>© {new Date().getUTCFullYear()} 骞言碎语</span>
      <nav aria-label="页脚导航">
        <a href="/categories/" aria-label="分类索引" title="分类索引"><SiteIcon name="categories" size={21} /></a>
        <a href="https://github.com/nealzhu" aria-label="GitHub 个人主页" title="GitHub 个人主页"><SiteIcon name="github" /></a>
        <a href="/rss.xml" aria-label="RSS 订阅" title="RSS 订阅"><SiteIcon name="rss" size={21} /></a>
      </nav>
    </footer>
  </body>
</html>
