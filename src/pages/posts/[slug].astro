---
import { render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { categories } from '../../lib/content-model';
import { categoryPath, publishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  return (await publishedPosts()).map(post => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, publishedAt, category, tags } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<Site title={title} description={description}>
  <div class="columns">
    <article>
      <header>
        <h1>{title}</h1>
        <time datetime={publishedAt}>{publishedAt}</time>
        <p>{description}</p>
      </header>
      <Content />
    </article>
    <aside aria-label="文章信息">
      <a href={categoryPath(category)}>{categories[category]}</a>
      {tags.length > 0 && <p class="quiet">{tags.join(' · ')}</p>}
      {toc.length > 0 && <nav aria-label="文章目录">
        <h2>文章目录</h2>
        <ul>
          {toc.map(({ depth, slug, text }) => <li class:list={[{ sub: depth === 3 }]}><a href={`#${slug}`}>{text}</a></li>)}
        </ul>
      </nav>}
    </aside>
  </div>
</Site>
<style>
  .columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(10rem, 14rem); gap: clamp(2rem, 5vw, 4rem); }
  article header { padding-bottom: .6rem; border-bottom: 1px solid #d5dad4; }
  aside { align-self: start; border-left: 1px solid #cdd4cd; padding-left: 1rem; }
  aside h2 { font-size: 1.1rem; }
  aside ul { list-style: none; padding: 0; }
  aside li { margin: .35rem 0; }
  .sub { padding-left: 1rem; }
  @media(max-width: 42rem) { .columns { grid-template-columns: minmax(0, 1fr); } }
</style>
